# Copy to tests/.env. Must point at a DEDICATED test database (name must end in "_test").
# The integration suite wipes and reinstalls Craft in this database on every run.
#
# DDEV: create it once with
#   ddev mysql -uroot -proot -e "CREATE DATABASE IF NOT EXISTS hotelbooking_test; GRANT ALL ON hotelbooking_test.* TO 'db'@'%';"

CRAFT_DB_DSN="mysql:host=db;port=3306;dbname=hotelbooking_test"
CRAFT_DB_USER="db"
CRAFT_DB_PASSWORD="db"
CRAFT_DB_TABLE_PREFIX=""
CRAFT_DB_SCHEMA=""
CRAFT_SECURITY_KEY="hotel-booking-test-security-key"
